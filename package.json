{
  "name": "iot-humidity-monitor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3005",
    "dev:https": "node server.js",
    "dev:backend": "cd backend && npm run dev",
    "dev:all": "concurrently --names \"FRONTEND,BACKEND\" -c \"cyan,yellow\" \"npm run dev\" \"npm run dev:backend\"",
    "dev:all:https": "concurrently --names \"FRONTEND,BACKEND\" -c \"cyan,yellow\" \"npm run dev:https\" \"npm run dev:backend\"",
    "build": "next build",
    "start": "next start -p 3002",
    "start:prod": "cross-env NODE_ENV=production node server.js",
    "prod:backend": "cd backend && npm run prod",
    "prod:all": "concurrently --names \"FRONTEND,BACKEND\" -c \"cyan,yellow\" \"npm run start:prod\" \"npm run prod:backend\"",
    "lint": "eslint"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-query-devtools": "^5.91.1",
    "axios": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "highcharts": "^12.4.0",
    "highcharts-react-official": "^3.2.3",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.0.0",
    "lucide-react": "^0.555.0",
    "next": "^16.1.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "recharts": "^3.5.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.7",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
