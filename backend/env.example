# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=iot_humidity_db
DB_USER=postgres
DB_PASSWORD=

# Server
PORT=8090
NODE_ENV=development

# JWT Authentication
JWT_SECRET=
JWT_EXPIRES_IN=7d

# CORS (Frontend URL)
FRONTEND_URL=http://localhost:3000

# Push Notification (VAPID Keys)
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@example.com
